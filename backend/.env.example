OPENAI_API_KEY=sk-your-key-here

# Optional: bootstrap admin account (User ID + password, no email)
AGORA_ADMIN_USER_ID=admin
AGORA_ADMIN_PASSWORD=change-me

# Production / Fly.io (set via `fly secrets` or platform env; local usually leave unset)
# AGORA_DATA_DIR=/data
# AGORA_DB_PATH=/data/agora.db
# AGORA_STATIC_DIR=/app/frontend/dist
# PORT=8080
# FLASK_DEBUG=0
# FLASK_HOST=0.0.0.0
