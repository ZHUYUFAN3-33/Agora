OPENAI_API_KEY=sk-your-key-here

# Optional: bootstrap admin account (User ID + password, no email)
AGORA_ADMIN_USER_ID=admin
AGORA_ADMIN_PASSWORD=change-me

# Model selection. AGORA_MODEL drives the agent turns; AGORA_SUMMARY_MODEL drives the
# summarisers, session memory and decision-map extraction. Both default to gpt-4o
# (decision-map extraction to gpt-4o-mini) when unset, i.e. unchanged behaviour.
# The gpt-5.x line rejects `temperature` and takes a reasoning budget instead; the
# request builder switches automatically, AGORA_REASONING_EFFORT tunes it
# (none|low|medium|high|xhigh|max, default none — turns are short, not analysis).
# AGORA_MODEL=gpt-5.6-terra
# AGORA_SUMMARY_MODEL=gpt-5.6-luna
# AGORA_REASONING_EFFORT=none

# Production / Fly.io (set via `fly secrets` or platform env; local usually leave unset)
# AGORA_DATA_DIR=/data
# AGORA_DB_PATH=/data/agora.db
# AGORA_STATIC_DIR=/app/frontend/dist
# PORT=8080
# FLASK_DEBUG=0
# FLASK_HOST=0.0.0.0
